{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taqtaqa",
  "main": "worker.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "routes": [
    { "pattern": "taqtaqa.com", "custom_domain": true },
    { "pattern": "www.taqtaqa.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // الـ Worker بيشتغل قبل الملفات، عشان تحويل www يوصل حتى للصفحة الرئيسية
    "run_worker_first": true
  },
  // حد لعدد رسايل «ادعم طقطقة» من كل جهاز: رسالة كل ١٠ ثواني، و٣ في الدقيقة
  "ratelimits": [
    { "name": "FB_BURST", "namespace_id": "1101", "simple": { "limit": 1, "period": 10 } },
    { "name": "FB_MINUTE", "namespace_id": "1102", "simple": { "limit": 3, "period": 60 } },
    // نبضات عدّاد الإحصائيات: ٣٠ في الدقيقة من كل IP
    { "name": "STATS_RL", "namespace_id": "1103", "simple": { "limit": 30, "period": 60 } }
  ],
  // عدّاد الإحصائيات (stats.js)
  "durable_objects": { "bindings": [{ "name": "STATS", "class_name": "Stats" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Stats"] }],
  "send_email": [
    { "name": "FEEDBACK", "destination_address": "ghofran.salem@gmail.com" }
  ],
  // تخزين بوت تليجرام (أقسام الجروب، والأعضاء الجداد، والسبام). (taqtaqa-bot)
  "kv_namespaces": [{ "binding": "BOT", "id": "e8dca5d0c55648539c196e2c9821e83a" }],
  // كل سبت: البوت بينزّل أوائل الترتيب الأسبوعي
  "triggers": { "crons": ["10 0 * * 6"] },
  "observability": { "enabled": true }
}
